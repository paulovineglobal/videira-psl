# Copie este arquivo para .env e ajuste conforme necessário:
#   cp .env.example .env
#
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).

# Fuso horário (Port St. Lucie, FL)
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Endereço em que o n8n será acessado.
# Para uso local, deixe como está.
N8N_HOST=localhost
N8N_PROTOCOL=http

# URL base usada nos webhooks gerados pelo n8n.
# Rodando localmente, serviços externos (Instagram, YouTube etc.) não
# conseguem alcançar localhost — para testes com webhooks use um túnel
# (ex.: cloudflared ou ngrok) e coloque a URL pública aqui:
# WEBHOOK_URL=https://seu-tunel.exemplo.com/
WEBHOOK_URL=http://localhost:5678/
